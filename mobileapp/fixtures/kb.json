  "cases": [
    {
      "id": "plain_prose",
      "why": "Baseline: lowercasing and stopword removal.",
      "fn": "tokenize",
      "input": {
        "text": "The white downy growth on the underside of a leaf"
      },
      "expect": {
        "tokens": [
          "white",
          "downy",
          "growth",
          "underside",
          "leaf"
        ]
      }
    },
    {
      "id": "dose_decimal",
      "why": "A decimal dose must survive as one token, not split at the point.",
      "fn": "tokenize",
      "input": {
        "text": "Apply mancozeb 2.5 g/litre of water"
      },
      "expect": {
        "tokens": [
          "apply",
          "mancozeb",
          "2.5",
          "litre",
          "water"
        ]
      }
    },
    {
      "id": "percentage",
      "why": "Percent strings are how labels express concentration.",
      "fn": "tokenize",
      "input": {
        "text": "Mancozeb 75% WP at 0.2%"
      },
      "expect": {
        "tokens": [
          "mancozeb",
          "75",
          "wp",
          "0.2"
        ]
      }
    },
    {
      "id": "hyphenated",
      "why": "Hyphens join product names and must not split them.",
      "fn": "tokenize",
      "input": {
        "text": "metalaxyl-m + mancozeb-75 ws"
      },
      "expect": {
        "tokens": [
          "metalaxyl-m",
          "mancozeb-75",
          "ws"
        ]
      }
    },
    {
      "id": "single_chars",
      "why": "Single characters are dropped AFTER stopwords, changing doc length.",
      "fn": "tokenize",
      "input": {
        "text": "a b c 1 2 potato"
      },
      "expect": {
        "tokens": [
          "potato"
        ]
      }
    },
    {
      "id": "mixed_case_units",
      "why": "Units and case: kg/ha, ML, pH.",
      "fn": "tokenize",
      "input": {
        "text": "Use 2 kg/ha at pH 6.5 in 500 ML water"
      },
      "expect": {
        "tokens": [
          "use",
          "kg",
          "ha",
          "ph",
          "6.5",
          "500",
          "ml",
          "water"
        ]
      }
    },
    {
      "id": "all_stopwords",
      "why": "A query of nothing but stopwords must tokenize to empty.",
      "fn": "tokenize",
      "input": {
        "text": "the a an and or of to in is are"
      },
      "expect": {
        "tokens": []
      }
    },
    {
      "id": "empty",
      "why": "Empty input, empty token list - not a crash.",
      "fn": "tokenize",
      "input": {
        "text": ""
      },
      "expect": {
        "tokens": []
      }
    },
    {
      "id": "punctuation_only",
      "why": "Punctuation yields nothing; the regex needs a leading alnum.",
      "fn": "tokenize",
      "input": {
        "text": "--- ... ***"
      },
      "expect": {
        "tokens": []
      }
    },
    {
      "id": "devanagari",
