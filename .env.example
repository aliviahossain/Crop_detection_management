# ---- Backend ----
APP_ENV=dev
DATABASE_URL=sqlite:///./cropguard.db
UPLOAD_DIR=backend/app/data/uploads

# ---- Detection model ----
# Drop trained weights here after Kaggle training (best.onnx preferred for CPU speed).
YOLO_ONNX_PATH=ml/weights/best.onnx
YOLO_PT_PATH=ml/weights/best.pt
DETECTION_CONF_THRESHOLD=0.25
DETECTION_IOU_THRESHOLD=0.45
# Below this, the case is auto-escalated to an expert instead of self-treatment.
LOW_CONFIDENCE_THRESHOLD=0.55

# ---- Weather ----
# OpenWeatherMap key. Leave blank to run on the deterministic synthetic feed.
OPENWEATHER_API_KEY=
WEATHER_PROVIDER=openweathermap
WEATHER_CACHE_TTL_SECONDS=1800

# ---- Advisory / RAG ----
CHROMA_DIR=backend/app/data/chroma
KB_DIR=backend/app/data/kb
# Free-text KB excerpt translation runs on Gemini (see GEMINI_API_KEY below).
# Without a key the advisory layer falls back to extractive retrieval + the
# built-in translated catalog (still fully functional). ANTHROPIC_API_KEY is
# retained only for backward compatibility and is no longer used.
ANTHROPIC_API_KEY=
ADVISORY_LLM_MODEL=gemini-2.5-flash

# ---- Assistant chatbot + advisory translation (Gemini) ----
# One key powers both the floating "Ask CropGuard" assistant and advisory
# free-text translation. Leave blank to run the offline fallbacks.
# Get a free key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ---- i18n ----
DEFAULT_LANGUAGE=en
SUPPORTED_LANGUAGES=en,mr,hi,bn

# ---- Frontend ----
VITE_API_BASE=http://localhost:8000
