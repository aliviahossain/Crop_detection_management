# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
*.mp4


# Env / secrets
.env
.env.local

# Data & models (never commit datasets or checkpoints)
# The trained weights (best.pt ~22MB, best.onnx ~44MB) stay out of git --
# distribute them out of band (release asset / Kaggle output / LFS) and drop
# them into ml/weights/. The small tuned config + model card below ARE tracked
# because the serving layer reads thresholds.json at runtime (absent -> every
# class falls back to a single 0.25 threshold, not the tuned per-class values).
datasets/
runs/
*.pt
*.onnx
!ml/weights/.gitkeep
!ml/weights/thresholds.json
!ml/weights/metrics.json
# 2 KB synthetic model. Without it the onnxruntime-web integration test skips
# silently on a fresh clone, which is worse than not having the test.
!frontend/src/lib/__tests__/fixtures/*.onnx
backend/app/data/uploads/
backend/app/data/chroma/
*.db
*.sqlite3

# Node
node_modules/
dist/
.vite/

# OS / editors
.DS_Store
Thumbs.db
.idea/
.vscode/

# Test scratch
backend/.pytest-tmp/

# ONNX Runtime WASM, generated by frontend/scripts/copy-ort-runtime.mjs
frontend/public/ort/

# --- croprow feature (croprow branch): crop-row localization ---
# Datasets live OUTSIDE the repo (see LETTUCE_ROOT). Never commit frames,
# videos, run outputs, or weights. Small tracked artifacts are the notebooks,
# utils.py, the data yaml, the train/val split lists, and RESULTS.md.
frames/
*.mp4
# runs/, *.pt, *.onnx and .venv/ are already ignored above (covers
# croprow/.venv/ and any exported croprow weights). Allow tracked weights
# that are deliberately dropped into croprow/models/:
croprow/models/*.pt

# --- croprow_disease feature (croprow-disease branch): 2-class plant health ---
# Datasets live OUTSIDE the repo (LETTUCE_ROOT / HEALTH_DATASET). Never commit
# frames, videos, run outputs, or weights. Small tracked artifacts are the
# notebooks, health.py / utils.py / dataset.py, the data yaml, the train/val
# split lists, and RESULTS.md.
# runs/, *.pt, *.onnx, *.mp4 and .venv/ are already ignored above. Allow tracked
# weights deliberately dropped into croprow_disease/models/:
croprow_disease/models/*.pt
croprow_disease/demo_clips/
# Scratch summary written by the conversion step; regenerated, not a source file.
croprow_disease/data/_conversion_summary.json
